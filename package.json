{
  "name": "e-commerce-backend",
  "version": "2.0.0",
  "description": "Backend NestJS Microservicios para e-commerce con Supabase",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build gateway && nest build auth && nest build products && nest build orders && nest build customers && nest build cart && nest build analytics && nest build storage",
    "build:gateway": "nest build gateway",
    "build:auth": "nest build auth",
    "build:products": "nest build products",
    "build:orders": "nest build orders",
    "build:customers": "nest build customers",
    "build:cart": "nest build cart",
    "build:analytics": "nest build analytics",
    "build:storage": "nest build storage",
    "format": "prettier --write \"{apps,libs}/**/*.ts\"",
    "start": "node scripts/start-all.js",
    "start:dev": "node scripts/start-all-dev.js",
    "start:gateway": "nest start gateway",
    "start:gateway:dev": "nest start gateway --watch",
    "start:auth": "nest start auth",
    "start:auth:dev": "nest start auth --watch",
    "start:products": "nest start products",
    "start:products:dev": "nest start products --watch",
    "start:orders": "nest start orders",
    "start:orders:dev": "nest start orders --watch",
    "start:customers": "nest start customers",
    "start:customers:dev": "nest start customers --watch",
    "start:cart": "nest start cart",
    "start:cart:dev": "nest start cart --watch",
    "start:analytics": "nest start analytics",
    "start:analytics:dev": "nest start analytics --watch",
    "start:storage": "nest start storage",
    "start:storage:dev": "nest start storage --watch",
    "start:prod": "node scripts/start-all-prod.js",
    "lint": "eslint \"{apps,libs}/**/*.ts\" --fix",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:cov": "jest --config jest.config.ts --coverage",
    "test:auth": "jest --config jest.config.ts --testPathPattern=apps/auth",
    "test:products": "jest --config jest.config.ts --testPathPattern=apps/products",
    "test:orders": "jest --config jest.config.ts --testPathPattern=apps/orders",
    "test:customers": "jest --config jest.config.ts --testPathPattern=apps/customers",
    "test:cart": "jest --config jest.config.ts --testPathPattern=apps/cart",
    "test:analytics": "jest --config jest.config.ts --testPathPattern=apps/analytics",
    "test:storage": "jest --config jest.config.ts --testPathPattern=apps/storage",
    "test:gateway": "jest --config jest.config.ts --testPathPattern=apps/gateway",
    "test:e2e": "node tests/e2e.test.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/mapped-types": "^2.0.6",
    "@nestjs/microservices": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@supabase/supabase-js": "^2.49.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "pdfkit": "^0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.5",
    "concurrently": "^9.1.2",
    "jest": "^30.2.0",
    "pg": "^8.18.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  }
}
